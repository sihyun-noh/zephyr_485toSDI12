/ {
	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
		zephyr,display = &ssd1309;
	};

	aliases {
		eeprom-0 = &eeprom0;
	};

	zephyr,user {
		ads1232-sclk-gpios = <&gpioa 5 GPIO_ACTIVE_HIGH>;
		ads1232-dout-gpios = <&gpioa 6 GPIO_ACTIVE_HIGH>;
		ads1232-pwdn-gpios = <&gpioa 7 GPIO_ACTIVE_HIGH>;
	};
};

&i2c1 {
	pinctrl-0 = <&i2c1_scl_pa15 &i2c1_sda_pb7>;
	pinctrl-names = "default";
	clock-frequency = <400000>;
	status = "okay";

	ssd1309: ssd1309@3c {
		compatible = "solomon,ssd1306fb";
		reg = <0x3c>;
		width = <128>;
		height = <64>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;
		segment-remap;
		com-invdir;
		prechargep = <0x22>;
	};
};

&i2c3 {
	pinctrl-0 = <&i2c3_scl_pa8 &i2c3_sda_pb5>;
	pinctrl-names = "default";
	clock-frequency = <100000>;
	status = "okay";

	eeprom0: eeprom@50 {
		compatible = "atmel,at24";
		reg = <0x50>;
		size = <32768>;
		pagesize = <64>;
		address-width = <16>;
		timeout = <5>;
	};
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};
